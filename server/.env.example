PORT=4000
# Atlas: if URI has no /dbname, MongoDB uses database "test" (where Shrish propty was saved).
# Optional: MONGODB_DB_NAME=rentlandlord for a clean separate database.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string

# CORS (optional when API + UI share one App Service — Azure sets WEBSITE_HOSTNAME)
CLIENT_ORIGIN=http://localhost:3000

# Microsoft Azure OpenAI / Foundry (AI Assistant)
# From Foundry → Deployments → grok-4-20-reasoning → Details tab
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=paste-key-from-details-tab
AZURE_OPENAI_DEPLOYMENT=grok-4-20-reasoning

# Azure App Service: add MONGODB_URI, JWT_SECRET, and SCM_DO_BUILD_DURING_DEPLOYMENT=false
# in Configuration → Application settings (do not commit .env)

# Email (Gmail app password, SendGrid SMTP, or Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RentLandlord <noreply@example.com>"

# Azure Blob (optional — leave empty to skip upload in dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=rent-documents
