PORT=4000
# Atlas: include /rentlandlord before ? OR set MONGODB_DB_NAME (default rentlandlord).
# Without a db name, MongoDB uses "test" and old indexes there cause duplicate errors.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/rentlandlord?retryWrites=true&w=majority
MONGODB_DB_NAME=rentlandlord
JWT_SECRET=change-me-to-a-long-random-string

# CORS (optional when API + UI share one App Service — Azure sets WEBSITE_HOSTNAME)
CLIENT_ORIGIN=http://localhost:3000

# Azure App Service: add MONGODB_URI, JWT_SECRET, and SCM_DO_BUILD_DURING_DEPLOYMENT=false
# in Configuration → Application settings (do not commit .env)

# Email (Gmail app password, SendGrid SMTP, or Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RentLandlord <noreply@example.com>"

# Azure Blob (optional — leave empty to skip upload in dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=rent-documents
